# gzcompanion-usage configuration. Copy to /etc/gzcompanion-usage/env (mode 0640, root:gzcompanion-usage)
# and fill in. Never commit a real token.

# Required: random secret (>= 32 chars) protecting /stats and /api/gzcompanion/stats.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STATS_TOKEN=

# Listen only on localhost - Cloudflare Tunnel connects locally; never expose this port publicly.
HOST=127.0.0.1
PORT=8787

# SQLite database file (the directory is created if missing).
DB_PATH=/var/lib/gzcompanion-usage/usage.sqlite

# Global abuse limits (no per-client tracking). Optional.
HEARTBEATS_PER_MINUTE=600
NEW_INSTALLATIONS_PER_HOUR=500
