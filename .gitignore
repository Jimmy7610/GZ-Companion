# Gradle build outputs
.gradle/
build/
out/
bin/

# Loom runtime & Minecraft client directories
run/
.fabric/

# Local GZ Companion runtime data (this Loom setup runs the client with the
# project root as its working directory, so config/ lands here, not in run/)
config/

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project

# OS junk
.DS_Store
Thumbs.db
Desktop.ini

# Logs
logs/
*.log

# .NET installer build outputs (distribution/installer) - built locally via build-installer.ps1,
# never committed. The mod jar it embeds is copied in from the main Gradle build at build time.
obj/
distribution/installer/GZCompanion.Installer.App/Assets/gzcompanion.jar
distribution/dist/
distribution/release/
